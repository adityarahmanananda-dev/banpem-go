# Database (PostgreSQL) - Supabase. Simpan kredensial hanya di .env,
# jangan pernah di-commit ke git. Gunakan sslmode=require untuk koneksi publik.
DATABASE_URL=postgresql://postgres.USER:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Direktori backup database otomatis
BACKUP_DIR=backups
# Alamat HTTP server
ADDR=:8080
# Admin pertama (dipakai hanya saat tabel users masih kosong)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-minimal-10-karakter
# Set true jika diakses lewat HTTPS
COOKIE_SECURE=false
# Kota pada blok tanda tangan laporan
REPORT_CITY=Jakarta
# Umur session login (jam)
SESSION_TTL_HOURS=12
# Backup otomatis setiap startup
BACKUP_ON_STARTUP=true
# Tulis ulang seluruh ledger saat startup (hanya untuk perbaikan data lama)
RESYNC_LEDGER_ON_STARTUP=false
# Token Bearer untuk GET /metrics (kosong = hanya admin yang bisa akses)
METRICS_TOKEN=
# Webhook JSON untuk alert error/panic/database down
ALERT_WEBHOOK_URL=
